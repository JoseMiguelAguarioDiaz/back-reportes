	<parameter name="artistId" class="java.lang.Long"/>
	<parameter name="imagen" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT a.id AS album_id, upper(a.title) AS album_title, upper(ar.name) AS artist_name, ar.profile_pic AS artist_profile_pic
FROM artists ar
JOIN albums a ON a.artist_id = ar.id
WHERE ar.id = $P{artistId} ]]>
	</queryString>
