	<import value="org.apache.commons.codec.binary.Base64"/>
	<parameter name="albumId" class="java.lang.Long"/>
	<parameter name="imagen" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.id AS album_id,
    upper(a.title) AS album_title,
    a.price,
    a.release_date,
    a.image,
    ar.name AS artist_name,
    s.title AS song_title,
    s.duracion AS song_duration
FROM albums a
INNER JOIN artists ar ON a.artist_id = ar.id
LEFT JOIN songs s ON s.album_id = a.id
WHERE a.id = $P{albumId}  
ORDER BY s.id]]>
	</queryString>
